# ============================================================================
# RestoCore Hub — variabili d'ambiente
# ----------------------------------------------------------------------------
# Copia in `.env` (`cp .env.example .env`) e riempi coi valori del progetto HUB.
# NON committare `.env` (git-ignored). Questo template SÌ.
# Le VITE_* sono client (pubbliche); FIREBASE_SERVICE_ACCOUNT è solo per gli
# script Admin (segreto, mai nel client).
# ============================================================================

# ---------------------------------------------------------------------------
# Firebase — progetto HUB (separato dai progetti operativi dei locali)
# Console Firebase → Impostazioni progetto → App web → SDK config.
# Ricorda di abilitare in Authentication → Sign-in method: Email/Password E Google.
# ---------------------------------------------------------------------------
VITE_FB_API_KEY=AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
VITE_FB_AUTH_DOMAIN=restocore-hub.firebaseapp.com
VITE_FB_PROJECT_ID=restocore-hub
VITE_FB_STORAGE_BUCKET=restocore-hub.appspot.com
VITE_FB_SENDER_ID=000000000000
VITE_FB_APP_ID=1:000000000000:web:xxxxxxxxxxxxxxxx

# ---------------------------------------------------------------------------
# Admin SDK — solo per gli script (es. set-admin.mjs). JSON del service account
# del progetto HUB su UNA riga. I "\n" della private_key restano letterali.
# Console Firebase → Impostazioni → Account di servizio → genera chiave privata.
# ---------------------------------------------------------------------------
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"restocore-hub","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...@restocore-hub.iam.gserviceaccount.com"}
