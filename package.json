{
  "name": "restocore-hub",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Control plane di RestoCore: registrazione ristoratori, wizard di configurazione, generazione menu, cruscotto di approvazione. Progetto separato dal motore operativo.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
